# Copy to .env and fill in. Never commit .env.

# packages/db — see packages/db/README.md for what these two roles are and why both exist
DATABASE_URL=postgresql://freyo:freyo@localhost:5432/freyo
TENANT_DATABASE_URL=postgresql://freyo_tenant:freyo_tenant@localhost:5432/freyo

